<mujoco model="scene_fetch">
    <!-- Fetch simulation scene: Microduck + ball + human thrower/return zone -->
    <include file="robot_groundcontact.xml" />
    <include file="ball.xml" />

    <visual>
        <headlight diffuse="0.7 0.7 0.7" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="150" elevation="-25" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
        <material name="zone_mat" rgba="0.1 0.8 0.3 0.35" />
        <material name="hand_mat" rgba="0.95 0.75 0.6 0.95" />
        <material name="arm_mat" rgba="0.2 0.4 0.8 0.9" />
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />

        <!-- Human Thrower & Return Target Zone (standing beside the robot) -->
        <body name="human_zone" pos="-0.4 0.28 0">
            <!-- Floor drop zone marker -->
            <geom name="zone_marker" type="cylinder" size="0.22 0.001" pos="0 0 0.001" material="zone_mat" contype="0" conaffinity="0" />
            <!-- Human torso stand representation -->
            <geom name="human_stand" type="cylinder" size="0.05 0.22" pos="0 0 0.22" rgba="0.25 0.35 0.45 0.7" contype="0" conaffinity="0" />
            <!-- Human arm & hand representation extending forward -->
            <geom name="human_arm" type="capsule" fromto="0 0 0.38 0.18 -0.05 0.34" size="0.025" material="arm_mat" contype="0" conaffinity="0" />
            <geom name="human_hand" type="sphere" size="0.035" pos="0.20 -0.05 0.34" material="hand_mat" contype="0" conaffinity="0" />
        </body>
    </worldbody>
</mujoco>

